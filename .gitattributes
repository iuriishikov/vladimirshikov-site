# Normalise line endings so a Windows checkout cannot poison a diff.
* text=auto eol=lf

*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf

# Binary assets — never diffed, never line-ending-mangled.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.woff binary
*.woff2 binary
*.pdf  binary

# Generated files: collapse in PR diffs and exclude from language stats.
pnpm-lock.yaml -diff linguist-generated=true
CHANGELOG.md   linguist-generated=true
