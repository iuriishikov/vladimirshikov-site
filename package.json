{
  "name": "vladimirshikov-site",
  "version": "0.0.0",
  "private": true,
  "description": "Vladimir Shikov — personal site. Next.js App Router + Feature-Sliced Design.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:install:all": "playwright install --with-deps",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "knip": "knip",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "commit": "cz",
    "release": "semantic-release",
    "docker:build": "docker build -t vladimirshikov-site:local .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env.local vladimirshikov-site:local",
    "clean": "rm -rf .next coverage playwright-report test-results storybook-static reports node_modules/.cache",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-query-devtools": "^5.102.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/bundle-analyzer": "16.3.2",
    "@next/eslint-plugin-next": "16.3.2",
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.102.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "cross-env": "^10.1.0",
    "cz-git": "^1.14.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "secretlint": "^13.0.4",
    "semantic-release": "^25.0.9",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "validate-branch-name": "^1.3.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "validate-branch-name": {
    "pattern": "^(main|develop)$|^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|hotfix|release)/[a-z0-9._-]+$",
    "errorMsg": "Branch name must be main, develop, or <type>/<kebab-case-description> — see docs/branching.md"
  }
}
