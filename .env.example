# -----------------------------------------------------------------------------
# Copy to `.env.local` for development. Every variable here is validated by
# src/shared/config/env.ts — an unknown or malformed value fails fast instead of
# surfacing as `undefined` at 3am.
#
# Two kinds of variable, and the difference matters:
#
#   * Server variables (no prefix) are read at RUNTIME. One image can therefore
#     be built once and promoted from staging to production unchanged.
#   * NEXT_PUBLIC_* variables are inlined into the client bundle at BUILD time.
#     They are baked into the image and cannot be changed afterwards — and they
#     are visible to anyone, so never put a secret behind that prefix.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- Server (read at runtime) ------------------------------------------------
# Canonical origin, used for metadataBase, sitemap.xml, robots.txt and OG tags.
SITE_URL=http://localhost:3000

# One of: development | staging | production.
# Anything other than `production` serves a `noindex` robots.txt.
APP_ENV=development

# Optional: outbound API the site talks to.
API_BASE_URL=

# Reported by /api/health. The deploy pipeline sets this to the released
# version so a running container can be traced back to a git tag.
APP_VERSION=0.0.0-dev

# --- Public (inlined into the browser bundle at build time) ------------------
# Optional privacy-friendly analytics. Leave empty to disable entirely.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Set to 1 to skip env validation. Only used by the Docker image build, which
# has no runtime secrets available at build time.
SKIP_ENV_VALIDATION=

# Set to true by `pnpm analyze` to emit the bundle report.
ANALYZE=
